{
  "name": "baronglock-vscode",
  "displayName": "BarongLock",
  "description": "Open, edit and save BarongLock locked files (.blj, .baronglock) as normal text.",
  "version": "0.1.0",
  "publisher": "sibernaga",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sibernaga/baronglock.git",
    "directory": "vscode"
  },
  "homepage": "https://sibernaga.github.io/baronglock/",
  "bugs": "https://github.com/sibernaga/baronglock/issues",
  "keywords": [
    "encryption",
    "baronglock",
    "blj",
    "aes-gcm",
    "secrets"
  ],
  "categories": [
    "Other"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onFileSystem:baronglock"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "baronglock.open",
        "title": "Unlock and Edit",
        "category": "BarongLock"
      },
      {
        "command": "baronglock.lockFile",
        "title": "Lock File",
        "category": "BarongLock"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "baronglock.open",
          "when": "resourceScheme == file && resourceFilename =~ /\\.(blj|baronglock)$/i",
          "group": "navigation@10"
        },
        {
          "command": "baronglock.lockFile",
          "when": "resourceScheme == file && !explorerResourceIsFolder && !(resourceFilename =~ /\\.(blj|baronglock)$/i)",
          "group": "navigation@10"
        }
      ],
      "editor/title/context": [
        {
          "command": "baronglock.lockFile",
          "when": "(resourceScheme == file || resourceScheme == untitled) && !(resourceFilename =~ /\\.(blj|baronglock)$/i)",
          "group": "navigation@10"
        }
      ]
    },
    "configuration": {
      "title": "BarongLock",
      "properties": {
        "baronglock.lockedExtension": {
          "type": "string",
          "enum": [
            "baronglock",
            "blj"
          ],
          "default": "baronglock",
          "markdownDescription": "Ending for files locked in VS Code: `.baronglock`, or the short `.blj`. Both are the same format."
        },
        "baronglock.lockMethod": {
          "type": "string",
          "enum": [
            "ask",
            "key",
            "password"
          ],
          "enumDescriptions": [
            "Ask each time.",
            "A new key, saved on this computer. Share the key file so others can open it.",
            "A password you choose. Type it to open the file, on any computer."
          ],
          "default": "ask",
          "markdownDescription": "How **Lock File** locks: with a new stored key, or with a password."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "baronglock.lockedFile",
        "displayName": "BarongLock",
        "selector": [
          {
            "filenamePattern": "*.blj"
          },
          {
            "filenamePattern": "*.baronglock"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.mjs --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=dist/extension.js",
    "vscode:prepublish": "npm run build",
    "test": "node --test spec/locked-file.spec.mjs",
    "test:vscode": "npm run build && node spec/integration/run.mjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "baronglock": "^0.3.0",
    "esbuild": "^0.28.2"
  }
}
